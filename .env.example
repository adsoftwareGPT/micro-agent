# ── micro-agent environment variables ──────────────────────────────────────
# Where to put this file so `micro-agent` finds it (first match wins):
#   1. $MAGENT_CONFIG_DIR/.env
#   2. $XDG_CONFIG_HOME/micro-agent/.env
#   3. ~/.config/micro-agent/.env                 ← recommended (no sudo, per-user)
#   4. /usr/share/micro-agent/.env                ← system-wide (deb install, needs sudo)
# Recommended:
#   mkdir -p ~/.config/micro-agent
#   cp /usr/share/micro-agent/.env.example ~/.config/micro-agent/.env
#   nano ~/.config/micro-agent/.env
# Provider to use: zai | deepseek | openrouter | opencode | ollama
PROVIDER=zai

# API keys (one per provider)
ZAI_KEY=
DEEPSEEK_KEY=
OPENROUTER_KEY=
OPENCODE_KEY=

# Optional model overrides (defaults shown)
# ZAI_MODEL=glm-5.2
# DEEPSEEK_MODEL=deepseek-v4-flash
# OPENROUTER_MODEL=xiaomi/mimo-v2.5
# OPENCODE_MODEL=deepseek-v4-flash-free
# VISION_MODEL=qwen/qwen2.5-vl-72b-instruct
